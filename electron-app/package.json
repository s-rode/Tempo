{
  "name": "tempo-electron-app",
  "version": "1.0.0",
  "private": true,
  "description": "Local macOS activity classification, focus sessions, and native notch timers",
  "main": "./out/main/index.js",
  "author": "Samuel R",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:with-typecheck": "bun run typecheck && electron-vite build",
    "build:notch-helper": "bash scripts/build-notch-helper.sh",
    "test:notch-animation-policy": "bash scripts/test-notch-animation-policy.sh",
    "test:notch-interaction-layout": "bash scripts/test-notch-interaction-layout.sh",
    "test:notch-overlap": "bash scripts/test-notch-overlap.sh",
    "test:notch-controller": "bash scripts/test-notch-controller.sh",
    "build:firefox-host": "bash scripts/build-firefox-host.sh",
    "build:firefox-extension": "mkdir -p build-resources && cd firefox-extension && zip -X -q ../build-resources/Tempo-Firefox-Companion-UNSIGNED.zip manifest.json background.js content.js",
    "build:local-server": "cd ../server && bun run build:local",
    "sign:mac:local": "bash scripts/sign-local-app.sh dist-local/mac-arm64/Tempo.app",
    "build:mac:local": "bun run build:assets && bun run build:notch-helper && bun run build:firefox-host && bun run build:firefox-extension && bun run build:local-server && bun run build && electron-builder --config electron-builder.local.yml --mac --dir --arm64 && bun run sign:mac:local",
    "install:local": "python3 scripts/install-local.py",
    "build:mac:local:install": "bun run build:mac:local && bun run install:local",
    "build:mac": "bun run build:mac:local",
    "build:mac:app-only": "bun run build:mac:local",
    "native-modules:rebuild": "bun run --cwd .. native:rebuild",
    "native-modules:rebuild:arm": "bun run native-modules:rebuild",
    "build:assets": "python3 scripts/generate-assets.py",
    "test:native-lifecycle": "ELECTRON_RUN_AS_NODE=1 electron scripts/verify-native-lifecycle.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@trpc/client": "^10.45.2",
    "@trpc/react-query": "^10.45.2",
    "@types/color": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^5.0.0",
    "crc": "^4.3.2",
    "framer-motion": "^12.12.2",
    "lucide-react": "^0.511.0",
    "node-addon-api": "^4.3.0",
    "react-router-dom": "^7.6.1",
    "shared": "workspace:*",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "electron": "35.1.5",
    "electron-builder": "26.0.15",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "license": "MIT"
}
